      "id": "9fdab7f5-79fe-46d1-9585-e1896c4f896a",
      "name": "PayDesk: bot info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $('PayDesk: bot info').first().json.api }}/getUpdates",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "offset",
              "value": "={{ $('PayDesk: bot info').first().json.offset }}"
            },
            {
              "name": "timeout",
              "value": "0"
            },
            {
              "name": "allowed_updates",
              "value": "[\"message\",\"callback_query\"]"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "5d7452fd-1431-4c9e-9aac-974bc8969002",
      "name": "Telegram: new messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Automation 2 - step 3: one item per new Telegram message or button tap.\n// Only private chats with the bot. Empty list = nothing new -> this run stops here.\nconst updates = $input.first().json.result || [];\nif (!updates.length) return [];\nconst next = Math.max(...updates.map((u) => u.update_id)) + 1;   // Telegram: \"I have read these\"\nconst out = [];\nfor (const u of updates) {\n  if (u.callback_query) {\n    const q = u.callback_query;\n    if (!q.message || q.message.chat.type !== \"private\") continue;\n    out.push({ json: { next_offset: next, chat_id: String(q.message.chat.id), text: null,\n                       callback_data: q.data || null, callback_id: q.id, message_id: null } });\n  } else if (u.message) {\n    const m = u.message;\n    if (m.chat.type !== \"private\") continue;\n    out.push({ json: { next_offset: next, chat_id: String(m.chat.id), text: m.text || null,\n                       callback_data: null, callback_id: null, message_id: m.message_id } });\n  }\n}\n// Nothing to answer (e.g. a group message) - still save the offset so it is not read again\nif (!out.length) out.push({ json: { next_offset: next, skip: true } });\nreturn out;\n"
      },
      "id": "77d697bf-4092-4f08-a1e4-bc9ea7c52249",
      "name": "Split messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=http://127.0.0.1:8001/api/automation/telegram/offset",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ offset: $json.next_offset }) }}"
      },
      "id": "ff49f92f-f573-4a3c-b344-0d922c7f324f",
      "name": "PayDesk: save offset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Offset is saved - now continue with every message (skip the \"nothing to answer\" item).\nreturn $('Split messages').all().filter((i) => !i.json.skip);\n"
      },
      "id": "71b2c3be-fc23-4c91-a4ff-60cec51508bb",
      "name": "Messages again",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
