    {
      "parameters": {
        "content": "## 2 · Save 'read up to here' first (no message is answered twice), then ask PayDesk what to answer",
        "height": 380,
        "width": 860,
        "color": 5
      },
      "id": "b494437d-1e0b-4e78-be26-756f5528d445",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        700,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8001/api/automation/telegram/message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text, callback_data: $json.callback_data, message_id: $json.message_id }) }}"
      },
      "id": "f0875ced-91dc-4a58-ba2f-7e7b952d5584",
      "name": "PayDesk: what to answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
