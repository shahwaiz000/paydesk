      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "31f643cb-f955-44ff-805f-0cd57ea294f7",
              "leftValue": "={{ $json.action }}",
              "rightValue": "ask_ai",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
