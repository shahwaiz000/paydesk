    {
      "parameters": {
        "content": "## 3 · Every evening at 8 pm: payday summary email to the accountant",
        "height": 260,
        "width": 960,
        "color": 5
      },
      "id": "633d4dde-4b77-48c2-ae06-58613a9c5e0f",
      "name": "Note 3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        840
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 20
            }
          ]
        }
      },
      "id": "190a078d-3a74-409b-956d-1f9d5630732d",
      "name": "Every evening 8 pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        940
      ]
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8001/api/automation/cash/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "34a80fa0-1edc-40bc-9cd2-c20cc7826e9e",
      "name": "PayDesk: payday summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        940
      ]
    },
    {
      "parameters": {
        "jsCode": "// Evening summary: how far is payday? Nothing to send if no month is approved.\nconst d = $input.first().json;\nif (!d.month) return [];\nconst t = d.totals;\nconst money = (x) => Number(x).toLocaleString(\"en-US\", { maximumFractionDigits: 2 });\nconst esc = (s) => String(s ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\nconst li = (arr, f) => arr.length ? \"<ul>\" + arr.slice(0, 15).map(f).join(\"\") + (arr.length > 15 ? `<li>… and ${arr.length - 15} more</li>` : \"\") + \"</ul>\" : \"<p>None ✅</p>\";\nconst html = `<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#1e293b\">\n<h2 style=\"margin:0 0 8px\">Payday ${esc(d.month.month_name)} – end of day</h2>\n<p><b>${d.stations_all_paid} of ${d.stations}</b> stations paid all cash drivers ·\n<b>${t.paid} of ${t.drivers}</b> drivers paid (SAR ${money(t.paid_amount)} of ${money(t.cash)})</p>\n<ul><li>✅ Confirmed by driver on Telegram: <b>${t.confirmed}</b></li>\n<li>⏳ Waiting for driver's answer: <b>${t.waiting}</b></li>\n<li>❌ Driver says wrong amount: <b style=\"color:${t.wrong ? \"#b91c1c\" : \"inherit\"}\">${t.wrong}</b></li>\n<li>Paid, driver not on Telegram: ${t.no_telegram}</li></ul>\n<h3 style=\"margin:16px 0 4px\">❌ Wrong amount</h3>\n${li(d.problems, (p) => `<li><b>${esc(p.driver_id)}</b> ${esc(p.station_code)} – paid SAR ${money(p.net)}, driver says ${p.said_amount != null ? \"SAR \" + money(p.said_amount) : \"different\"}${p.note ? ` – “${esc(p.note)}”` : \"\"}</li>`)}\n<h3 style=\"margin:16px 0 4px\">Stations not started</h3>\n${li(d.stations_not_started, (s) => `<li>${esc(s.station_code)} ${esc(s.station)} – ${s.drivers} drivers, SAR ${money(s.cash)}</li>`)}\n<h3 style=\"margin:16px 0 4px\">Stations partly paid</h3>\n${li(d.stations_partly_paid, (s) => `<li>${esc(s.station_code)} ${esc(s.station)} – ${s.paid}/${s.drivers} paid</li>`)}\n<p><a href=\"${d.payday_url}\">Open Payday in PayDesk</a></p>\n<p style=\"color:#64748b;font-size:12px\">Sent by n8n – PayDesk automation 3. No paper signature sheets needed.</p></div>`;\nreturn [{ json: { to: d.notify_to, html,\n  subject: `PayDesk payday ${d.month.month_name}: ${d.stations_all_paid}/${d.stations} stations paid · ${t.confirmed} confirmed · ${t.wrong} wrong amount` } }];\n"
      },
      "id": "cc62ec16-9743-4b5a-974a-f72b4fca2980",
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        940
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "4c2c524d-59d7-44fd-8bfb-860c75c73491",
      "name": "Gmail: payday summary",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        940
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "Pxr2gspwgYb2UkBY",
          "name": "Gmail account"
        }
      }
    }
  ],
