{
  "name": "PayDesk · 04 Cash received? (Telegram + Gmail)",
  "nodes": [
    {
      "parameters": {
        "content": "## 1 · Every 10 s: cashier marked a driver PAID → ask the driver on Telegram\n(✅ / ❌ taps are answered by workflow 03)",
        "height": 380,
        "width": 1360,
        "color": 4
      },
      "id": "33d32f77-7214-4145-b52d-1a6710673efd",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      },
      "id": "826ed449-f040-4821-adc2-b78de3270cf9",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8001/api/automation/telegram/bot",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "2286f511-3fad-47cd-9e22-0939838784b1",
      "name": "PayDesk: bot info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8001/api/automation/cash/to-ask",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "49d63910-5721-4b17-bc65-3cc48a7d6c30",
      "name": "PayDesk: drivers to ask",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per driver to ask: \"did you receive your cash?\" (or ONE reminder after 24 h).\nreturn ($input.first().json.messages || []).map((m) => ({ json: m }));\n"
      },
      "id": "810c31c9-df4d-4bef-8f36-eca0575c9254",
      "name": "Split questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('PayDesk: bot info').first().json.api }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Split questions').item.json.telegram) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "d48f0b78-6a1b-428f-912c-256d8e21f22d",
      "name": "Telegram: did you get your cash?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8001/api/automation/cash/{{ $('Split questions').item.json.payment_id }}/asked",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: $('Split questions').item.json.kind, ok: $json.ok === true }) }}"
      },
      "id": "0395364f-4b0f-46f9-9a7a-0a900f3a9ec3",
      "name": "PayDesk: mark asked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "content": "## 2 · Driver said WRONG AMOUNT → email the accountant right away",
        "height": 260,
        "width": 960,
        "color": 3
      },
      "id": "fa228558-059a-4d6a-8a6c-8d010eb9c2f9",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        520
      ]
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8001/api/automation/cash/alerts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "3ab167c9-496f-431b-aab8-4cddb8c611dd",
      "name": "PayDesk: wrong-amount alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "// Drivers who said \"wrong amount\" -> one email each to the accountant.\nconst d = $input.first().json;\nconst money = (x) => Number(x).toLocaleString(\"en-US\", { maximumFractionDigits: 2 });\nconst esc = (s) => String(s ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\nreturn (d.alerts || []).map((a) => ({ json: {\n  payment_id: a.payment_id, to: d.notify_to,\n  subject: `⚠️ Cash problem: ${a.driver_id} at ${a.station_code} says he got ${a.said_amount != null ? \"SAR \" + money(a.said_amount) : \"a different amount\"}`,\n  html: `<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#1e293b\">\n<h2 style=\"margin:0 0 8px\">Driver says the cash amount is wrong</h2>\n<p><b>${esc(a.driver_id)} · ${esc(a.driver_name)}</b> – ${esc(a.station_code)} ${esc(a.station)} – ${esc(a.month_name)}</p>\n<ul><li>Cashier <b>${esc(a.paid_by)}</b> marked him paid: <b>SAR ${money(a.amount)}</b></li>\n<li>Driver says he received: <b>${a.said_amount != null ? \"SAR \" + money(a.said_amount) : \"not stated\"}</b>${a.difference != null ? ` (difference SAR ${money(a.difference)})` : \"\"}</li>\n<li>Driver's note: “${esc(a.note)}”</li></ul>\n<p>Please check with the station cashier. The driver was told the payroll team will answer him.</p>\n<p style=\"color:#64748b;font-size:12px\">Sent by n8n – PayDesk automation 3 (driver answered on Telegram)</p></div>` } }));\n"
      },
      "id": "e74abb26-c103-4698-b562-bb17765643d1",
      "name": "Split alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        620
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "82c4a954-3427-4854-919a-202863fb6706",
      "name": "Gmail: alert accountant",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        620
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "Pxr2gspwgYb2UkBY",
          "name": "Gmail account"
        }
      }
    },
    {
